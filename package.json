{
	"name": "@data_lineage/monorepo",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"release_logs": {
		"features": [],
		"fixes": [],
		"refactors": [],
		"hotfixes": []
	},
	"engines": {
		"npm": ">=10.0.0",
		"node": ">=20.0.0"
	},
	"packageManager": "npm@10.0.0",
	"scripts": {
		"dev": "turbo run dev --parallel --no-cache",
		"dev:ui:react": "turbo run dev --filter=react-client",
		"dev:server:nest": "turbo run dev --filter=nestjs-server",
		"turbo:ls": "turbo ls",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"biome": "npx @biomejs/biome check",
		"biome:fix": "npx @biomejs/biome check --write .",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"biome check --files-ignore-unknown=true --colors=force"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"@types/dagre": "^0.7.51",
		"browserslist-to-esbuild": "2.1.1",
		"cross-env": "7.0.3",
		"husky": "9.1.7",
		"lint-staged": "15.5.0",
		"turbo": "2.4.4"
	},
	"dependencies": {
		"@joint/core": "^4.1.3",
		"@monaco-editor/react": "^4.7.0-rc.0",
		"react-rnd": "10.5.2"
	}
}
