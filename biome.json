{
	"$schema": "https://biomejs.dev/schemas/2.1.2/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!apps/react-client/src/utils/decimal.ts",
			"!**/.__mf__win",
			"!**/.__mf__win",
			"!**/reports/**/*",
			"!**/.__mf__temp",
			"!**/generated/**/*",
			"!**/node_modules",
			"!**/releases",
			"!**/images",
			"!**/dist",
			"!**/packages/**/dist",
			"!**/package-lock.json",
			"!**/packages/**/package.json",
			"!**/package.json",
			"!**/build",
			"!**/out",
			"!**/.git",
			"!**/.gitignore",
			"!**/*.md",
			"!**/*.lockb",
			"!**/LICENSE",
			"!**/src/common/api/core",
			"!**/src/common/api/services",
			"!**/.cache",
			"!**/.cache/vite-app",
			"!**/.cache/vite-app/**/*",
			"!**/.cache/**/*",
			"!**/deps_temp*",
			"!**/deps_temp_*",
			"!**/*_temp_*",
			"!**/.vite/**/*",
			"!**/node_modules/.vite/**/*",
			"!apps/react-client/dist",
			"!apps/react-client/dist/**/*"
		]
	},
	"formatter": {
		"enabled": true,
		"lineEnding": "lf"
	},
	"assist": { "actions": { "source": { "organizeImports": "off" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": "off",
			"security": {
				"noDangerouslySetInnerHtml": "off"
			},
			"style": {
				"useNodejsImportProtocol": "off",
				"useConst": "warn",
				"noDefaultExport": "off",
				"noUnusedTemplateLiteral": "off",
				"noUselessElse": "off",
				"noNonNullAssertion": "off",
				"useTemplate": "off",
				"noParameterAssign": "warn",
				"useImportType": "off",
				"useSelfClosingElements": {
					"fix": "safe",
					"level": "warn",
					"options": {}
				},
				"useAsConstAssertion": "error",
				"useDefaultParameterLast": "error",
				"useEnumInitializers": "error",
				"useSingleVarDeclarator": "error",
				"useNumberNamespace": "error",
				"noInferrableTypes": "error"
			},
			"correctness": {
				"noUnsafeOptionalChaining": "warn",
				"useExhaustiveDependencies": "off",
				"noUnusedImports": {
					"fix": "safe",
					"level": "warn"
				}
			},
			"complexity": {
				"noUselessEscapeInRegex": "off",
				"useLiteralKeys": "off",
				"useOptionalChain": "off",
				"useArrowFunction": "off",
				"noBannedTypes": "off",
				"noUselessFragments": "off",
				"noForEach": "off",
				"noUselessUndefinedInitialization": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noPrototypeBuiltins": "warn",
				"noArrayIndexKey": "off",
				"noAssignInExpressions": "off",
				"noThenProperty": "off"
			},
			"performance": {
				"noAccumulatingSpread": "warn",
				"noDelete": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	}
}
