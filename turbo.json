{
	"$schema": "https://turborepo.org/schema.json",
	"envMode": "loose",
	"tasks": {
		"lib:build": {
			"dependsOn": []
		},
		"lint": {
			"dependsOn": []
		},
		"dev:god": {
			"dependsOn": [],
			"persistent": true,
			"cache": false,
			"passThroughEnv": ["NODE_ENV"],
			"env": ["NODE_ENV"]
		},
		"dev": {
			"dependsOn": [],
			"persistent": true,
			"cache": false,
			"passThroughEnv": ["NODE_ENV"],
			"env": ["NODE_ENV"]
		},
		"start": {
			"dependsOn": []
		},
		"build": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"prod": {
			"dependsOn": []
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": [],
			"inputs": ["src/**/*.tsx", "src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"]
		},
		"//#prettier": {
			"dependsOn": [],
			"outputs": []
		},
		"deploy": {
			"dependsOn": ["build", "test", "prettier"],
			"outputs": []
		}
	}
}
