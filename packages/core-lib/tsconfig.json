{
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"baseUrl": "./",
		"rootDir": "json4u_leftovers",
		"outDir": "dist",
		"paths": {
			"@/*": ["json4u_leftovers/*"]
		},
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"resolveJsonModule": false,
		"incremental": false
	},
	"include": ["json4u_leftovers"],
	"exclude": ["node_modules", "**/__tests__/*", "build"]
}
