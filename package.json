{
	"name": "data_lineage_monorepo",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*",
		"auxiliary/*"
	],
	"release_logs": {
		"features": [],
		"fixes": [],
		"refactors": [],
		"hotfixes": []
	},
	"engines": {
		"npm": ">=10.0.0",
		"node": ">=20.0.0"
	},
	"packageManager": "npm@10.0.0",
	"scripts": {
		"dev": "turbo run dev --parallel --no-cache",
		"dev:ui": "turbo run dev --filter=react-client",
		"dev:server:nest": "turbo run dev --filter=nestjs-server",
		"dev:fullstack": "turbo run dev --filter=react-client --filter=nestjs-server",
		"turbo:ls": "turbo ls",
		"build:ui": "turbo run build --filter=react-client",
		"build:nest": "turbo run build --filter=nestjs-server",
		"start:server": "turbo run start --filter=nestjs-server",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"biome": "npx @biomejs/biome check",
		"biome:fix": "npx @biomejs/biome@2.3.2 check --log-level=error --diagnostic-level=error --unsafe --fix ./apps/react-client/src ./apps/nestjs-server/src",
		"prepare": "husky",
		"db:reset": "npm run db:reset:dev",
		"db:reset:dev": "node ./apps/nestjs-server/scripts/reset-dev-db.js",
		"db:reset:dev:restart": "npm run db:reset:dev && npm run dev",
		"test:load:smoke": "cd aux/artillery && npm run test:smoke",
		"test:load:basic": "cd aux/artillery && npm run test:basic",
		"test:load:stress": "cd aux/artillery && npm run test:stress",
		"test:load:endurance": "cd aux/artillery && npm run test:endurance",
		"test:load:all": "cd aux/artillery && npm run test:all",
		"test:load:all:with-report": "cd aux/artillery && npm run test:all:with-report",
		"test:load:report": "cd aux/artillery && npm run test:report",
		"test:load:report:combined": "cd aux/artillery && npm run report:combined"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"biome check --files-ignore-unknown=true --colors=force"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.2",
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"@originjs/vite-plugin-federation": "^1.4.1",
