{
	"name": "react-client",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "cross-env NODE_ENV=development vite serve",
		"dev:god": "cross-env NODE_ENV=development NO_ROLES=true vite serve",
		"build": "cross-env NODE_ENV=production vite build",
		"start": "serve -s build",
		"prod": "npm build && npm start",
		"biome": "npx @biomejs/biome check",
		"biome:fix": "npx @biomejs/biome check --log-level=error --diagnostic-level=error --fix --unsafe $(pwd)/src"
	},
	"dependencies": {
		"@dagrejs/dagre": "^1.1.5",
		"@data-lineage/shared": "file:../../packages/shared",
		"@data-lineage/shared-schemas": "file:../../packages/shared-schemas",
		"@xyflow/react": "^12.8.6",
		"jsondiffpatch": "^0.7.3"
	},
	"devDependencies": {
		"@originjs/vite-plugin-federation": "^1.4.1",
		"@svgr/rollup": "8.1.0",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.2.0",
		"@testing-library/user-event": "^14.6.1",
		"@vitejs/plugin-react": "4.7.0",
		"globals": "^16.0.0",
		"typescript": "^5.8.2",
		"vite": "7.0.6",
		"vite-plugin-checker": "0.10.1",
		"vite-plugin-node-polyfills": "0.21.0",
		"vite-plugin-static-copy": "3.1.1",
		"vite-plugin-svgr": "4.2.0",
		"vite-tsconfig-paths": "5.0.1"
	}
}
