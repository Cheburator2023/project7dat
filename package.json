{
	"name": "data_lineage_monorepo",
	"version": "1.0.0",
	"private": true,
	"workspaces": ["apps/*", "packages/*"],
	"release_logs": {
		"features": [],
		"fixes": [],
		"refactors": [],
		"hotfixes": []
	},
	"engines": {
		"npm": ">=10.0.0",
		"node": ">=20.0.0"
	},
	"packageManager": "npm@10.0.0",
	"scripts": {
		"dev": "turbo run dev --parallel --no-cache",
		"dev:ui": "turbo run dev --filter=react-client",
		"dev:server:nest": "turbo run dev --filter=nestjs-server",
		"turbo:ls": "turbo ls",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"biome": "npx @biomejs/biome check",
		"biome:fix": "npx @biomejs/biome check --log-level=error --diagnostic-level=error --fix --unsafe ./apps/react-client/src",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx}": ["biome check --files-ignore-unknown=true --colors=force"]
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"@types/dagre": "^0.7.51",
		"@types/js-cookie": "^3.0.6",
		"@types/lodash-es": "4.17.12",
		"@types/node": "^22.13.14",
		"@types/papaparse": "^5.3.15",
		"@types/react": "19.1.2",
		"@types/react-dom": "19.1.2",
		"browserslist-to-esbuild": "2.1.1",
		"cross-env": "7.0.3",
		"husky": "9.1.7",
		"lint-staged": "15.5.0",
		"turbo": "2.4.4",
		"type-fest": "^4.26.1"
	},
	"dependencies": {
		"@biowasm/aioli": "^3.2.0",
		"@fontsource/inter": "^5.2.5",
		"@hookform/resolvers": "^3.9.0",
		"@monaco-editor-enhancer/json-editor": "^1.1.2",
		"@monaco-editor/react": "^4.7.0",
		"@sentry/react": "^8.26.0",
		"@sentry/utils": "^8.27.0",
		"@xyflow/react": "^12.1.1",
		"@xyflow/system": "^0.0.43",
		"ag-charts-community": "11.3.0",
		"ag-charts-locale": "11.3.0",
		"ag-charts-types": "11.3.0",
		"ag-grid-community": "33.3.0",
		"ag-grid-enterprise": "33.3.0",
		"ag-grid-react": "33.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.0.0",
		"comlink": "4.4.2",
		"fuzzysort": "^3.1.0",
		"idb-keyval": "^6.2.1",
		"js-cookie": "^3.0.5",
		"jsonc-parser": "^3.3.1",
		"jsonpath-plus": "^10.2.0",
		"lodash-es": "4.17.21",
		"lucide-react": "0.487.0",
		"papaparse": "^5.4.1",
		"react-drag-drop-files": "^2.3.10",
		"react-hook-form": "^7.53.0",
		"react-resizable-panels": "^2.1.1",
		"sharp": "^0.33.5",
		"sonner": "^1.5.0",
		"tailwind-merge": "^2.5.2",
		"tailwindcss-animate": "^1.0.7",
		"usehooks-ts": "^3.1.0",
		"zod": "^3.25.20"
	}
}
