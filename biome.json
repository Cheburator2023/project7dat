{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"ignore": [
			"generated/**/*",
			"node_modules",
			"releases",
			"images",
			"dist",
			"build",
			"out",
			".git",
			".gitignore",
			"**/*.md",
			"**/*.lockb",
			"LICENSE",
			".cache/**/*"
		]
	},
	"formatter": {
		"enabled": true,
		"lineEnding": "lf"
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"noSvgWithoutTitle": "off",
				"useMediaCaption": "off"
			},
			"style": {
				"noDefaultExport": "info",
				"noUnusedTemplateLiteral": "off",
				"noUselessElse": "off",
				"useSelfClosingElements": {
					"fix": "safe",
					"level": "warn"
				}
			},
			"correctness": {
				"useExhaustiveDependencies": "off",
				"noUnusedImports": {
					"fix": "none",
					"level": "warn"
				}
			},
			"complexity": {
				"noForEach": "warn"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noPrototypeBuiltins": "warn",
				"noArrayIndexKey": "off"
			},
			"performance": {
				"noAccumulatingSpread": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
