{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"ignore": [
			"generated/**/*",
			"node_modules",
			"releases",
			"images",
			"dist",
			"build",
			"out",
			".git",
			".gitignore",
			"**/*.md",
			"**/*.lockb",
			"LICENSE",
			".cache/**/*"
		]
	},
	"formatter": {
		"enabled": true,
		"lineEnding": "lf"
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"noSvgWithoutTitle": "info"
			},
			"style": {
				"noDefaultExport": "info"
			},
			"correctness": {
				"useExhaustiveDependencies": "off",
				"noUnusedImports": "warn"
			},
			"complexity": {
				"noForEach": "warn"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noPrototypeBuiltins": "warn",
				"noArrayIndexKey": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
