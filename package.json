{
	"name": "@data_lineage/monorepo",
	"version": "1.0.0",
	"private": true,
	"workspaces": ["apps/*", "packages/*"],
	"release_logs": {
		"features": [],
		"fixes": [],
		"refactors": [],
		"hotfixes": []
	},
	"engines": {
		"npm": ">=10.0.0",
		"node": ">=20.0.0"
	},
	"lint-staged": {
		"*.{ts}": ["biome check --files-ignore-unknown=true --colors=force"]
	},
	"scripts": {
		"dev": "turbo run dev --parallel --no-cache",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"biome": "npx @biomejs/biome check",
		"biome:fix": "npx @biomejs/biome check --write .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"@biomejs/biome": "1.9.4",
		"browserslist-to-esbuild": "2.1.1",
		"cross-env": "7.0.3",
		"husky": "9.1.7",
		"lint-staged": "15.5.0",
		"turbo": "2.4.4"
	}
}
